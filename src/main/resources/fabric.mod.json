{
  "schemaVersion": 1,
  "id": "savelogic",
  "version": "${version}",
  "name": "SaveLogic",
  "description": "Save and load your singleplayer worlds to a private GitHub repository.",
  "authors": ["zinngar"],
  "contact": {
    "sources": "https://github.com/zinngar/Savelogic"
  },
  "environment": "client",

  "entrypoints": {
    "main": [
      "com.zinngar.savelogic.SaveLogic"
    ],
    "client": [
      "com.zinngar.savelogic.client.SaveLogicClient"
    ]
  },

  "mixins": [
    {
      "config": "savelogic.mixins.json",
      "environment": "client"
    }
  ],

  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  }
}
